{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer Fulfillment BFF",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [
    {
      "oidc": []
    }
  ],
  "paths": {
    "/api/orders": {
      "post": {
        "operationId": "placeOrder",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceOrder"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted before fulfillment; returns orderId, version and status",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid/missing JWT",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not owned, absent, or projection not yet visible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting idempotency key, stale version, or ineligible cancellation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate or capacity limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable; retry commands with the same key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer-owned items, page, size and consistency",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid/missing JWT",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not owned, absent, or projection not yet visible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting idempotency key, stale version, or ineligible cancellation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate or capacity limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable; retry commands with the same key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "orderDetails",
        "responses": {
          "200": {
            "description": "order, projection, commandVersion and degraded; projection includes projectedAt and version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetails"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid/missing JWT",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not owned, absent, or projection not yet visible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting idempotency key, stale version, or ineligible cancellation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate or capacity limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable; retry commands with the same key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Cancellation recorded or already in progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid/missing JWT",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not owned, absent, or projection not yet visible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting idempotency key, stale version, or ineligible cancellation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate or capacity limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable; retry commands with the same key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}/events": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "trackOrder",
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE order/reset events; id is aggregate version; heartbeat comments",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid/missing JWT",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient role",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not owned, absent, or projection not yet visible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting idempotency key, stale version, or ineligible cancellation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate or capacity limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable; retry commands with the same key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "http://localhost:8180/realms/shop/.well-known/openid-configuration"
      }
    },
    "schemas": {
      "PlaceOrder": {
        "type": "object",
        "required": [
          "sku",
          "quantity",
          "amount",
          "currency",
          "paymentMode",
          "shippingMode"
        ],
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{1,40}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "amount": {
            "type": "number",
            "minimum": 0.01,
            "multipleOf": 0.01,
            "maximum": 9999999999.99
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "INR"
            ]
          },
          "paymentMode": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "REJECT",
              "TIMEOUT_BEFORE",
              "TIMEOUT_AFTER",
              "AMBIGUOUS",
              "COMPENSATION_RETRY"
            ],
            "description": "LOCAL SIMULATOR behavior only"
          },
          "shippingMode": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "REJECT",
              "TIMEOUT_BEFORE",
              "TIMEOUT_AFTER",
              "AMBIGUOUS",
              "COMPENSATION_RETRY"
            ],
            "description": "LOCAL SIMULATOR behavior only"
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "OrderView": {
        "type": "object",
        "required": [
          "orderId",
          "customer",
          "status",
          "version",
          "sku",
          "quantity",
          "amount",
          "currency",
          "progress"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{1,40}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "amount": {
            "type": "number",
            "minimum": 0.01,
            "multipleOf": 0.01,
            "maximum": 9999999999.99
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "INR"
            ]
          },
          "paymentMode": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "REJECT",
              "TIMEOUT_BEFORE",
              "TIMEOUT_AFTER",
              "AMBIGUOUS",
              "COMPENSATION_RETRY"
            ],
            "description": "LOCAL SIMULATOR behavior only"
          },
          "shippingMode": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "REJECT",
              "TIMEOUT_BEFORE",
              "TIMEOUT_AFTER",
              "AMBIGUOUS",
              "COMPENSATION_RETRY"
            ],
            "description": "LOCAL SIMULATOR behavior only"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "customer": {
            "type": "string",
            "description": "Authenticated subject; never accepted from an identity header"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "COMPENSATING",
              "MANUAL_RECOVERY",
              "CANCELLED",
              "FAILED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "progress": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "projectedAt": {
            "type": "string"
          },
          "consistency": {
            "const": "eventual"
          }
        }
      },
      "OrderDetails": {
        "type": "object",
        "required": [
          "order",
          "projection",
          "commandVersion",
          "degraded"
        ],
        "properties": {
          "order": {
            "$ref": "#/components/schemas/OrderView"
          },
          "projection": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OrderView"
              },
              {
                "type": "object",
                "required": [
                  "unavailable"
                ],
                "properties": {
                  "unavailable": {
                    "const": true
                  }
                }
              }
            ]
          },
          "commandVersion": {
            "type": "integer",
            "minimum": 1
          },
          "degraded": {
            "type": "boolean"
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "size",
          "consistency"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderView"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "consistency": {
            "const": "eventual"
          }
        }
      }
    }
  }
}
