{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "customer"
      },
      {
        "name": "operator"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "ops",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "shop",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/",
        "http://localhost:18080/"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:18080"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shop",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "shop-ops",
      "publicClient": false,
      "secret": "local-ops-only",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "defaultClientScopes": [
        "ops"
      ],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shop",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "email": "alice@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "alice-local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Demo",
      "email": "bob@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "bob-local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    }
  ]
}